{
  "name": "kingdoms-harvest-server",
  "version": "1.0.0",
  "description": "Backend del juego Kingdoms Harvest",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node -e \"require('./src/config/database').initDatabase().then(db => db.migrate.latest({directory: './migrations'})).then(() => process.exit(0))\"",
    "test": "jest --verbose --forceExit --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "knex": "^3.2.10",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "pg": "^8.21.0",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.7.4",
    "sql.js": "^1.10.0",
    "ssh2": "^1.17.0"
  },
  "overrides": {
    "form-data": "^4.0.1",
    "qs": "^6.14.1",
    "tough-cookie": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2"
  }
}
