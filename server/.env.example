# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: NUNCA commitear .env a git.
# Para el mnemónico del hot wallet, el método más seguro es almacenarlo
# como un archivo de texto en server/secrets/TON_HOT_WALLET_MNEMONIC
# (ver §Secrets abajo). El fallback a env var emite una advertencia en prod.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot (REQUERIDO)
BOT_TOKEN=tu_token_de_botfather_aqui
WEBAPP_URL=https://tu-dominio.com
BOT_USERNAME=kingdomharvestbot

# Server
PORT=3001
NODE_ENV=development

# Base de datos
DATABASE_URL=./data/kingdoms.db

# Game Config
TICK_INTERVAL_MS=60000

# Monitoring (opcional — omitir para desactivar Sentry)
SENTRY_DSN=                            # https://sentry.io/settings/<org>/projects/<project>/keys/

# Redis (opcional — omitir para caché local y rate-limit en memoria)
# Con Redis activo: rate limiting compartido entre workers PM2 + caché leaderboard/perfil
REDIS_URL=                             # redis://localhost:6379 | redis://:password@host:6379

# TON Blockchain (requerido para retiros de tokens)
TON_NETWORK=testnet                    # testnet | mainnet
TON_API_KEY=                           # TonCenter API key (evita rate limits)

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — dos formas de proveer el mnemónico:
#
# OPCIÓN A (recomendada para producción): archivo de texto plano en
#   server/secrets/TON_HOT_WALLET_MNEMONIC
#   → gitignoreado, puede ser montado vía Docker secrets / K8s secrets
#
# OPCIÓN B (desarrollo / staging): variable de entorno a continuación
#   → el servidor emite una advertencia en NODE_ENV=production
#
# SECRETS_DIR=/ruta/personalizada/secrets   # opcional, sobreescribe el default
# ─────────────────────────────────────────────────────────────────────────────
TON_HOT_WALLET_MNEMONIC=palabra1 palabra2 ... palabra24

# Claude workflow helpers (scripts/claude-reset-notify.js, scripts/claude-reply-listener.js)
# Use a SEPARATE BotFather bot — reusing BOT_TOKEN will 409-conflict with the game bot poller.
CLAUDE_BOT_TOKEN=
CLAUDE_CHAT_ID=
