# SECURITY: Nunca commitear .env a git.
# Para producción en VPS, considerar systemd EnvironmentFile o Docker secrets.

# Telegram Bot (REQUERIDO)
BOT_TOKEN=tu_token_de_botfather_aqui
WEBAPP_URL=https://tu-dominio.com

# Server
PORT=3001
NODE_ENV=development

# Base de datos
DATABASE_URL=./data/kingdoms.db

# Game Config
TICK_INTERVAL_MS=60000

# TON Blockchain (requerido para retiros de tokens)
TON_NETWORK=testnet
TON_API_KEY=
TON_HOT_WALLET_MNEMONIC=

# Claude workflow helpers (scripts/claude-reset-notify.js, scripts/claude-reply-listener.js)
# Use a SEPARATE BotFather bot — reusing BOT_TOKEN will 409-conflict with the game bot poller.
CLAUDE_BOT_TOKEN=
CLAUDE_CHAT_ID=
