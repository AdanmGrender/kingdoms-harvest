# Build de APK (vite build --mode apk). El WebView no tiene proxy Vite, así que
# la API debe ser ABSOLUTA. Emulador Android → 10.0.2.2 mapea al localhost del host.
# Teléfono real: cambiá esto por la IP LAN de la PC (p.ej. http://192.168.1.50:3001)
# o un túnel, y re-buildeá (npm run build:apk && npx cap sync android).
VITE_API_URL=http://10.0.2.2:3001
